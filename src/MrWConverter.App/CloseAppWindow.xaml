<Window x:Class="MrWConverter.App.CloseAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MrWConverter.App.Resources"
        Title="MrWConverter"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource SectionTitle}"
                   FontSize="18"
                   TextWrapping="Wrap"
                   Text="{x:Static res:Strings.CloseAppQuestion}" />

        <TextBlock Margin="0,8,0,0"
                   Style="{StaticResource SecondaryText}"
                   TextWrapping="Wrap"
                   Text="{x:Static res:Strings.CloseAppHelp}" />

        <TextBlock x:Name="BusyText"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Text="{x:Static res:Strings.CloseAppBusy}" />

        <CheckBox x:Name="DontAskAgainBox"
                  Margin="0,16,0,0"
                  Content="{x:Static res:Strings.CloseAppDontAsk}" />

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="HideButton"
                    Padding="16,7"
                    IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}"
                    Content="{x:Static res:Strings.CloseAppHide}"
                    Click="Hide_Click" />
            <Button x:Name="ExitButton"
                    Margin="8,0,0,0"
                    Padding="16,7"
                    Content="{x:Static res:Strings.Close}"
                    Click="Exit_Click" />
            <Button Margin="8,0,0,0"
                    Padding="16,7"
                    IsCancel="True"
                    Content="{x:Static res:Strings.Cancel}" />
        </StackPanel>
    </StackPanel>
</Window>
