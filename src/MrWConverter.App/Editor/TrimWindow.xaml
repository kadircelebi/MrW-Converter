<Window x:Class="MrWConverter.App.Editor.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MrWConverter.App.Resources"
        Title="{x:Static res:Strings.ToolTrim}"
        Width="900" Height="620" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Video: the first and the last frame that stay. -->
        <Border x:Name="StartFrameCard" Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
            <Image x:Name="StartFrame" Stretch="Uniform" />
        </Border>
        <Border x:Name="EndFrameCard" Grid.Column="2" Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
            <Image x:Name="EndFrame" Stretch="Uniform" />
        </Border>

        <!-- Sound: the wave, darkened outside the part that stays. -->
        <Border x:Name="WaveCard"
                Grid.ColumnSpan="3"
                Style="{StaticResource Card}"
                Padding="8"
                ClipToBounds="True"
                Visibility="Collapsed">
            <Grid>
                <Image x:Name="Wave" Stretch="Fill" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BeforeColumn" Width="0*" />
                        <ColumnDefinition x:Name="KeptColumn" Width="1*" />
                        <ColumnDefinition x:Name="AfterColumn" Width="0*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Fill="#99000000" />
                    <Rectangle Grid.Column="2" Fill="#99000000" />
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="StartText" DockPanel.Dock="Right" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static res:Strings.TrimStart}" />
            </DockPanel>
            <Slider x:Name="StartSlider"
                    Margin="0,4,0,0"
                    IsMoveToPointEnabled="True"
                    AutomationProperties.Name="{x:Static res:Strings.TrimStart}"
                    ValueChanged="StartSlider_ValueChanged" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="EndText" DockPanel.Dock="Right" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static res:Strings.TrimEnd}" />
            </DockPanel>
            <Slider x:Name="EndSlider"
                    Margin="0,4,0,0"
                    IsMoveToPointEnabled="True"
                    AutomationProperties.Name="{x:Static res:Strings.TrimEnd}"
                    ValueChanged="EndSlider_ValueChanged" />
        </StackPanel>

        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="KeptText" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Style="{StaticResource SecondaryText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,2,16,0"
                           Text="{x:Static res:Strings.TrimHelp}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Margin="0,0,8,0"
                    Padding="16,7"
                    IsCancel="True"
                    Content="{x:Static res:Strings.Cancel}" />

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Padding="16,7"
                    IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}"
                    Content="{x:Static res:Strings.TrimSave}"
                    Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
