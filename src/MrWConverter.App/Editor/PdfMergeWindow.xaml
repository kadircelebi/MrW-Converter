<Window x:Class="MrWConverter.App.Editor.PdfMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MrWConverter.App.Resources"
        Title="{x:Static res:Strings.ToolMergePdf}"
        Width="640" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12" LastChildFill="False">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button x:Name="SortButton" DockPanel.Dock="Right" Padding="12,7" Content="{x:Static res:Strings.PdfMergeSort}" Click="Sort_Click" />
            <Button x:Name="DownButton" DockPanel.Dock="Right" Margin="0,0,6,0" Padding="12,7" Content="{x:Static res:Strings.PdfMergeDown}" Click="Down_Click" />
            <Button x:Name="UpButton" DockPanel.Dock="Right" Margin="0,0,6,0" Padding="12,7" Content="{x:Static res:Strings.PdfMergeUp}" Click="Up_Click" />
        </DockPanel>

        <ListBox x:Name="FileList"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ItemContainerStyle="{StaticResource FileCard}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Single"
                 SelectionChanged="FileList_SelectionChanged"
                 AutomationProperties.Name="{x:Static res:Strings.PdfMergeOrder}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Border Width="44" Height="44" Margin="0,0,12,0" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="22" />
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="{Binding Details}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Margin="0,0,0,6" Text="{x:Static res:Strings.PdfMergePageSize}" />
            <ListBox x:Name="SizeList"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ItemContainerStyle="{StaticResource FormatPill}"
                     SelectionMode="Single"
                     AutomationProperties.Name="{x:Static res:Strings.PdfMergePageSize}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource SecondaryText}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Text="{x:Static res:Strings.PdfMergeHelp}" />

            <Button Grid.Column="1"
                    Margin="0,0,8,0"
                    Padding="16,7"
                    IsCancel="True"
                    Content="{x:Static res:Strings.Cancel}" />

            <Button Grid.Column="2"
                    Padding="16,7"
                    IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}"
                    Content="{x:Static res:Strings.PdfMergeSave}"
                    Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
