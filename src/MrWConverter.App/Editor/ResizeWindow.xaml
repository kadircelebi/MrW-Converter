<Window x:Class="MrWConverter.App.Editor.ResizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MrWConverter.App.Resources"
        Title="{x:Static res:Strings.ToolResize}"
        Width="560" MinWidth="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TextBlock Margin="0,16,0,6" Text="{x:Static res:Strings.ResizeNewSize}" />

        <RadioButton x:Name="PercentChoice"
                     GroupName="Mode"
                     IsChecked="True"
                     Content="{x:Static res:Strings.ResizeByPercent}"
                     Checked="Choice_Changed" />
        <StackPanel Margin="28,4,0,8" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=PercentChoice}">
            <ComboBox x:Name="PercentBox"
                      Width="110"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      AutomationProperties.Name="{x:Static res:Strings.ResizeByPercent}"
                      TextBoxBase.TextChanged="Value_TextChanged">
                <ComboBoxItem Content="25" />
                <ComboBoxItem Content="50" />
                <ComboBoxItem Content="75" />
                <ComboBoxItem Content="150" />
                <ComboBoxItem Content="200" />
                <ComboBoxItem Content="400" />
            </ComboBox>
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="%" />
        </StackPanel>

        <RadioButton x:Name="SideChoice"
                     GroupName="Mode"
                     Content="{x:Static res:Strings.ResizeByLongestSide}"
                     Checked="Choice_Changed" />
        <StackPanel Margin="28,4,0,8" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=SideChoice}">
            <ComboBox x:Name="SideBox"
                      Width="110"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      AutomationProperties.Name="{x:Static res:Strings.ResizeByLongestSide}"
                      TextBoxBase.TextChanged="Value_TextChanged">
                <ComboBoxItem Content="3840" />
                <ComboBoxItem Content="2560" />
                <ComboBoxItem Content="1920" />
                <ComboBoxItem Content="1280" />
                <ComboBoxItem Content="1080" />
                <ComboBoxItem Content="640" />
            </ComboBox>
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="px" />
        </StackPanel>

        <RadioButton x:Name="BoxChoice"
                     GroupName="Mode"
                     Content="{x:Static res:Strings.ResizeByBox}"
                     Checked="Choice_Changed" />
        <StackPanel Margin="28,4,0,0" IsEnabled="{Binding IsChecked, ElementName=BoxChoice}">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="WidthBox"
                         Width="90"
                         Text="1080"
                         AutomationProperties.Name="{x:Static res:Strings.ResizeWidth}"
                         TextChanged="Value_TextChanged" />
                <TextBlock Margin="8,0" VerticalAlignment="Center" Text="×" />
                <TextBox x:Name="HeightBox"
                         Width="90"
                         Text="1080"
                         AutomationProperties.Name="{x:Static res:Strings.ResizeHeight}"
                         TextChanged="Value_TextChanged" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="px" />
            </StackPanel>
            <RadioButton x:Name="FitChoice"
                         Margin="0,8,0,0"
                         GroupName="Box"
                         IsChecked="True"
                         Content="{x:Static res:Strings.ResizeFit}"
                         Checked="Choice_Changed" />
            <RadioButton x:Name="FillChoice"
                         Margin="0,4,0,0"
                         GroupName="Box"
                         Content="{x:Static res:Strings.ResizeFill}"
                         Checked="Choice_Changed" />
        </StackPanel>

        <TextBlock x:Name="PreviewText"
                   Margin="0,16,0,0"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="LargerText"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Text="{x:Static res:Strings.ResizeLarger}" />

        <TextBlock Style="{StaticResource SecondaryText}"
                   Margin="0,12,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="{x:Static res:Strings.ResizeHelp}" />

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0"
                    Padding="16,7"
                    IsCancel="True"
                    Content="{x:Static res:Strings.Cancel}" />
            <Button x:Name="SaveButton"
                    Padding="16,7"
                    IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}"
                    Content="{x:Static res:Strings.ResizeSave}"
                    Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
