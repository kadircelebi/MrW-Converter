<Window x:Class="MrWConverter.App.Editor.ShrinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MrWConverter.App.Resources"
        Title="{x:Static res:Strings.ToolShrink}"
        Width="560" MinWidth="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TextBlock Margin="0,16,0,6" Text="{x:Static res:Strings.ShrinkTarget}" />

        <RadioButton x:Name="ShareChoice"
                     GroupName="Target"
                     IsChecked="True"
                     Content="{x:Static res:Strings.ShrinkByShare}"
                     Checked="Choice_Changed" />
        <DockPanel Margin="28,4,0,8" IsEnabled="{Binding IsChecked, ElementName=ShareChoice}">
            <TextBlock x:Name="ShareText"
                       DockPanel.Dock="Right"
                       MinWidth="140"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       FontWeight="SemiBold"
                       AutomationProperties.LiveSetting="Polite" />
            <Slider x:Name="ShareSlider"
                    Minimum="10" Maximum="90"
                    SmallChange="5" LargeChange="10"
                    TickFrequency="5" IsSnapToTickEnabled="True"
                    IsMoveToPointEnabled="True"
                    VerticalAlignment="Center"
                    Value="50"
                    AutomationProperties.Name="{x:Static res:Strings.ShrinkByShare}"
                    ValueChanged="Share_ValueChanged" />
        </DockPanel>

        <RadioButton x:Name="LimitChoice"
                     GroupName="Target"
                     Content="{x:Static res:Strings.ShrinkByLimit}"
                     Checked="Choice_Changed" />
        <StackPanel Margin="28,4,0,8" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=LimitChoice}">
            <ComboBox x:Name="LimitBox"
                      Width="110"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      AutomationProperties.Name="{x:Static res:Strings.ShrinkByLimit}"
                      TextBoxBase.TextChanged="Limit_TextChanged">
                <ComboBoxItem Content="5" />
                <ComboBoxItem Content="10" />
                <ComboBoxItem Content="25" />
                <ComboBoxItem Content="50" />
                <ComboBoxItem Content="100" />
                <ComboBoxItem Content="500" />
            </ComboBox>
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="MB" />
        </StackPanel>

        <RadioButton x:Name="NoTargetChoice"
                     GroupName="Target"
                     Content="{x:Static res:Strings.ShrinkNoTarget}"
                     Checked="Choice_Changed" />

        <TextBlock Margin="0,16,0,6" Text="{x:Static res:Strings.ShrinkLongestSide}" />
        <ListBox x:Name="SideList"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ItemContainerStyle="{StaticResource FormatPill}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Single"
                 AutomationProperties.Name="{x:Static res:Strings.ShrinkLongestSide}"
                 SelectionChanged="Side_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <TextBlock Style="{StaticResource SecondaryText}"
                   Margin="0,12,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="{x:Static res:Strings.ShrinkHelp}" />

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0"
                    Padding="16,7"
                    IsCancel="True"
                    Content="{x:Static res:Strings.Cancel}" />
            <Button x:Name="SaveButton"
                    Padding="16,7"
                    IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}"
                    Content="{x:Static res:Strings.ShrinkSave}"
                    Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
