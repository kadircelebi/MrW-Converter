<Window x:Class="MrWConverter.App.Editor.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MrWConverter.App.Resources"
        xmlns:editor="clr-namespace:MrWConverter.App.Editor"
        Title="{x:Static res:Strings.ToolEdit}"
        Width="1000" Height="780" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
            <Grid>
                <MediaElement x:Name="Player"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Manual"
                              ScrubbingEnabled="True"
                              Volume="1"
                              Stretch="Uniform"
                              MediaOpened="Player_MediaOpened"
                              MediaFailed="Player_MediaFailed"
                              MediaEnded="Player_MediaEnded" />
                <!-- A frame from FFmpeg until the player opens, and for good if it can't. For sound, the wave. -->
                <Image x:Name="Still" Stretch="Uniform" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,12,0,8" LastChildFill="False">
            <Button x:Name="ToStartButton" Padding="10,7" Click="ToStart_Click" AutomationProperties.Name="{x:Static res:Strings.EditToStart}" ToolTip="{x:Static res:Strings.EditToStart}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE892;" />
            </Button>
            <Button x:Name="PlayButton" Margin="6,0,0,0" Padding="14,7" IsEnabled="False" Click="Play_Click" AutomationProperties.Name="{x:Static res:Strings.EditPlay}" ToolTip="{x:Static res:Strings.EditPlay}">
                <TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xE768;" />
            </Button>
            <Button x:Name="ToEndButton" Margin="6,0,0,0" Padding="10,7" Click="ToEnd_Click" AutomationProperties.Name="{x:Static res:Strings.EditToEnd}" ToolTip="{x:Static res:Strings.EditToEnd}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE893;" />
            </Button>
            <TextBlock x:Name="TimeText" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />

            <Button x:Name="RedoButton" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="12,7" Content="{x:Static res:Strings.EditRedo}" Click="Redo_Click" />
            <Button x:Name="UndoButton" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="12,7" Content="{x:Static res:Strings.EditUndo}" Click="Undo_Click" />
            <Button x:Name="RemoveButton" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="12,7" Click="Remove_Click" />
            <Button x:Name="SplitButton" DockPanel.Dock="Right" Padding="12,7" Content="{x:Static res:Strings.EditSplit}" Click="Split_Click" />
        </DockPanel>

        <editor:EditTimeline x:Name="Timeline" Grid.Row="2" Height="78" />

        <ListBox x:Name="ClipList"
                 Grid.Row="3"
                 Margin="0,8,0,0"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ItemContainerStyle="{StaticResource FormatPill}"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="ClipList_SelectionChanged"
                 AutomationProperties.Name="{x:Static res:Strings.EditClips}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="KeptText" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Style="{StaticResource SecondaryText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,2,16,0"
                           Text="{x:Static res:Strings.EditHelp}" />
                <TextBlock x:Name="NoPlaybackText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,4,16,0"
                           Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{x:Static res:Strings.EditNoPlayback}" />
            </StackPanel>

            <CheckBox x:Name="SeparateBox"
                      Grid.Column="1"
                      Margin="0,0,16,0"
                      VerticalAlignment="Center"
                      Content="{x:Static res:Strings.EditSeparate}"
                      Checked="SeparateBox_Changed"
                      Unchecked="SeparateBox_Changed" />

            <Button Grid.Column="2"
                    Margin="0,0,8,0"
                    Padding="16,7"
                    IsCancel="True"
                    Content="{x:Static res:Strings.Cancel}" />

            <Button x:Name="SaveButton"
                    Grid.Column="3"
                    Padding="16,7"
                    Style="{DynamicResource AccentButtonStyle}"
                    Content="{x:Static res:Strings.EditSave}"
                    Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
