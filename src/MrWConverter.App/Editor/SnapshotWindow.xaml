<Window x:Class="MrWConverter.App.Editor.SnapshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MrWConverter.App.Resources"
        Title="{x:Static res:Strings.ToolSnapshot}"
        Width="900" Height="680" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
            <Image x:Name="Frame" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="TimeText" DockPanel.Dock="Right" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{x:Static res:Strings.SnapshotTime}" />
            </DockPanel>
            <Slider x:Name="TimeSlider"
                    Margin="0,4,0,0"
                    IsMoveToPointEnabled="True"
                    AutomationProperties.Name="{x:Static res:Strings.SnapshotTime}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource SecondaryText}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Text="{x:Static res:Strings.SnapshotHelp}" />

            <Button Grid.Column="1"
                    Margin="0,0,8,0"
                    Padding="16,7"
                    IsCancel="True"
                    Content="{x:Static res:Strings.Cancel}" />

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Padding="16,7"
                    IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}"
                    Content="{x:Static res:Strings.SnapshotSave}"
                    Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
