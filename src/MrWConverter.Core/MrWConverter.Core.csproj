<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows, for its PDF engine. Keep it in step with the app project. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- PDFsharp asks for 8.0.1, which has known vulnerabilities. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Formats\catalog.json" LogicalName="MrWConverter.Core.Formats.catalog.json" />
    <InternalsVisibleTo Include="MrWConverter.Core.Tests" />
  </ItemGroup>

</Project>
