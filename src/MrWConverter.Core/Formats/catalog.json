{
  "aliases": {
    "jpeg": "jpg",
    "tif": "tiff",
    "aif": "aiff",
    "m4v": "mp4"
  },
  "groups": [
    {
      "name": "image",
      "inputs": [ "jpg", "png", "webp", "tiff", "bmp", "avif" ],
      "outputs": [ "jpg", "png", "webp", "tiff", "bmp", "avif", "pdf" ],
      "tools": [ "shrink", "removeBackground", "crop", "censor", "mergePdf" ]
    },
    {
      "name": "document",
      "inputs": [ "pdf" ],
      "outputs": [ "docx", "png", "jpg", "txt" ],
      "tools": [ "mergePdf", "splitPdf" ]
    },
    {
      "name": "office",
      "inputs": [ "doc", "docx", "odt", "rtf", "txt", "xls", "xlsx", "ods", "csv", "ppt", "pptx", "odp" ],
      "outputs": [ "pdf" ],
      "tools": [ "mergePdf" ]
    },
    {
      "name": "audio",
      "inputs": [ "mp3", "m4a", "wav", "flac", "ogg", "opus", "aiff", "wma" ],
      "outputs": [ "mp3", "m4a", "wav", "flac", "ogg", "opus" ],
      "tools": [ "edit" ]
    },
    {
      "name": "video",
      "inputs": [ "mp4", "mov", "mkv", "webm", "avi", "wmv" ],
      "outputs": [ "mp4", "mov", "mkv", "webm", "gif", "mp3", "m4a" ],
      "tools": [ "shrink", "edit", "cropVideo", "muteVideo", "snapshot" ]
    },
    {
      "name": "animation",
      "inputs": [ "gif" ],
      "outputs": [ "mp4", "mov", "mkv", "webm" ]
    }
  ]
}
