<?xml version="1.0" encoding="utf-8"?>
<!--
  Identity Name, Publisher and PublisherDisplayName are development placeholders.
  Replace them with the values Partner Center shows after the app name is reserved.
  scripts\package.ps1 fills in Version and ProcessorArchitecture.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 rescap">

  <Identity Name="MrWConverter.Dev"
            Publisher="CN=MrWConverterDev"
            Version="0.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MrWConverter</DisplayName>
    <PublisherDisplayName>MrWConverter</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="tr-tr" />
  </Resources>

  <Dependencies>
    <!-- Keep MinVersion in step with SupportedOSPlatformVersion in the app project. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="MrWConverter"
                 Executable="MrWConverter.exe"
                 uap10:RuntimeBehavior="packagedClassicApp"
                 uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="MrWConverter"
                          Description="Convert images, audio and video between formats on your PC."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Off until the user asks for it in the app. Keep TaskId in step with WindowsStartup.cs. -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="MrWConverterStartup" Enabled="false" DisplayName="MrWConverter" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
